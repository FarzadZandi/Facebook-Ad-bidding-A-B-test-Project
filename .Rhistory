# Bar Plot for Earnings
ggplot(data, aes(x = Group, y = Earning, fill = Group)) +
geom_bar(stat = "summary", fun = "mean") +
labs(title = "Mean Earnings by Group", x = "Group", y = "Earnings") +
theme_minimal()
